# Copy to .env (never commit it). README.md has a one-liner that fills in the secrets.

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -hex 32
API_KEY_SECRET=
# openssl rand -hex 32. Encrypts provider keys at rest; keep a copy, losing it loses them.
STORAGE_ENCRYPTION_KEY=
# openssl rand -base64 16. The first dashboard login.
INITIAL_PASSWORD=

# Only with `--profile tunnel`: Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Docker token.
TUNNEL_TOKEN=
